{
  "name": "@masagroup/ecore",
  "version": "1.6.0",
  "description": "ecore typescript library",
  "author": "MASA Group",
  "license": "MPL-2.0",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "require": "./dist/cjs/index.js",
      "import": "./dist/esm/index.js",
      "default": "./dist/esm/index.js"
    }
  },
  "scripts": {
    "build": "npm run build-types && npm run build-esm && npm run build-cjs",
    "build-types": "tsc -b tsconfig.types.json",
    "build-esm": "tsc -b tsconfig.esm.json",
    "build-cjs": "tsc -b tsconfig.cjs.json && ncp ./package-cjs.json ./dist/cjs/package.json",
    "pretty": "node scripts/remove-unused-imports.mjs && prettier --write src/**/*.ts",
    "lint": "oxlint src",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "engines": {
    "node": ">=16"
  },
  "devDependencies": {
    "@types/deep-equal": "^1.0.4",
    "@vitest/coverage-v8": "^5.0.4",
    "deep-equal": "^2.2.3",
    "ncp": "^2.0.0",
    "oxlint": "^1.88.0",
    "prettier": "^3.9.10",
    "ts-mockito": "^2.6.1",
    "tslib": "^2.8.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@types/path-browserify": "^1.0.3",
    "@types/sax": "^1.2.7",
    "async-mutex": "^0.5.0",
    "id128": "^1.6.6",
    "path-browserify": "^1.0.1",
    "sax": "^1.6.1",
    "ts-results-es": "^7.1.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.64.6"
  }
}
