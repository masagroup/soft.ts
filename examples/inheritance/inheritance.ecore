<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="inheritance" nsURI="http:///org/eclipse/emf/examples/inheritance/inheritance.ecore/1.0.0"
    nsPrefix="inheritance">
  <eClassifiers xsi:type="ecore:EClass" name="Named" abstract="true">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Linkable" abstract="true" interface="true">
    <eStructuralFeatures xsi:type="ecore:EReference" name="link" eType="#//Anchor"
        eOpposite="#//Anchor/linked"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Node" eSuperTypes="#//Named #//Linkable"/>
  <eClassifiers xsi:type="ecore:EClass" name="Anchor">
    <eStructuralFeatures xsi:type="ecore:EReference" name="linked" eType="#//Linkable"
        unsettable="true" eOpposite="#//Linkable/link"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Child" abstract="true" interface="true">
    <eStructuralFeatures xsi:type="ecore:EReference" name="parent" eType="#//Parent"
        eOpposite="#//Parent/child"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Leaf" eSuperTypes="#//Named #//Child"/>
  <eClassifiers xsi:type="ecore:EClass" name="Parent">
    <eStructuralFeatures xsi:type="ecore:EReference" name="child" eType="#//Child"
        containment="true" eOpposite="#//Child/parent"/>
  </eClassifiers>
</ecore:EPackage>
